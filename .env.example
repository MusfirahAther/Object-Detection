# Environment Variables — VisDrone YOLO11s Detection App
# ========================================================
# Copy this file to `.env` and fill in values as needed.
# NEVER commit `.env` to version control.

# ── Flask ──────────────────────────────────────────────
# Secret key for Flask session signing (generate with: python -c "import secrets; print(secrets.token_hex())")
SECRET_KEY=your-secret-key-here

# Set to "true" to enable debug mode locally (never in production)
FLASK_DEBUG=false

# Port for local development (default: 5000)
PORT=5000

# ── Model ──────────────────────────────────────────────
# Override the default model path (default: models/best.pt)
# Useful if you store weights outside the repo or use a different checkpoint.
# MODEL_PATH=models/best.pt

# ── Dataset (training only) ─────────────────────────────
# Absolute path to the VisDrone dataset root directory.
# Required only if re-running training or evaluation; not needed for inference.
# VISDRONE_PATH=/path/to/VisDrone
